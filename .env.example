# Environment Variables for DagoEng F&B Management

# Development Database (PostgreSQL)
DATABASE_URL=""

# Isolated Test Database (PostgreSQL)
DATABASE_URL_TEST=""

# Developer Role Simulator Flag (true for dev/qa, false/unset in production)
ENABLE_ROLE_SIMULATOR=""

# Session Security Secret (Required in production, minimum 32 characters)
SESSION_SECRET=""

# POS QRIS Webhook Secret (Required in production for HMAC-SHA256 verification)
QRIS_WEBHOOK_SECRET=""

# Supervisor Override PIN for Static QRIS Manual Verification (Required for manual override)
SUPERVISOR_OVERRIDE_PIN=""

# Server Port
PORT=""
NODE_ENV=""

# WhatsApp Gateway (Fonnte)
FONNTE_API_TOKEN=""
FONNTE_TARGET_PHONE=""

# DOKU Payment Gateway
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_API_URL="https://api-sandbox.doku.com"
DOKU_NOTIFICATION_URL="/api/webhooks/doku"
DOKU_CALLBACK_URL=""
DOKU_SIMULATION_MODE="false"

# Transactional Email Service (Task S-05, S-08)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dago Creative Hub <tickets@dagoeng.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
